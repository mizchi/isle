  "css": ".page{display:grid;grid-template-columns:160px}.bar{display:grid;grid-template-columns:minmax(0,1fr);background:#246;color:#fff;padding:8px}.label{font-size:16px;line-height:24px;white-space:nowrap}"
 },
 {
  "id": "rows",
  "title": "A grid row too short for its item",
  "code": "E_LAYOUT_ITEM_SIZE",
  "width": 672,
  "height": 690,
  "message": ".a requires 70px but receives 40px on block axis at viewport 672px × 690px",
  "shots": [
   "rows-violation.png"
  ],
  "html": "<main class=\"page\"><div class=\"a\"></div><div class=\"b\"></div></main>",
  "css": ".page{display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:40px 40px;background:#eee}.a{height:70px;background:#fc9}.b{height:30px;background:#9cf}"
 },
 {
  "id": "page-overflow",
  "title": "A box that makes the page scroll sideways (100vw with a scrollbar)",
  "code": "E_LAYOUT_ITEM_SIZE",
  "width": 672,
  "height": 690,
  "message": ".hero requires 672px but receives 657px on inline axis at viewport 672px × 690px",
  "shots": [
   "page-overflow-violation.png"
  ],
  "html": "<main class=\"page\"><div class=\"hero\"></div></main>",
  "css": "html{overflow-y:scroll}body{padding:0}.page{display:grid;grid-template-columns:minmax(0,1fr)}.hero{width:100vw;height:120px;background:#c9f}"
 },
 {
  "id": "image-ratio",
  "title": "An image whose reserved ratio differs from its file",
  "code": "E_LAYOUT_IMAGE_RATIO",
  "width": 320,
  "height": 480,
  "message": ".hero reserves the ratio 400/400 but /wide.png is 32×16: its height changes when it loads",
  "shots": [
   "image-ratio-before.png",
   "image-ratio-after.png"
  ],
  "html": "<main class=\"page\"><img class=\"hero\" src=\"/wide.png\" width=\"400\" height=\"400\" alt=\"\"><p class=\"after\">The text below the image</p></main>",
  "css": ".page{display:grid;grid-template-columns:minmax(0,1fr)}.hero{display:block;width:100%;height:auto;background:#ddd}.after{height:40px;background:#eee}"
 },
 {
  "id": "hover-shift",
  "title": "A :hover rule that grows a card and pushes the content below",
  "code": "E_LAYOUT_HOVER_SHIFT",
  "width": 320,
  "height": 480,
  "message": "Hovering .card moves .below (blockStart by 50px at viewport 320px × 480px): a layout shift without an excusing input. Change paint or transform on :hover, or reserve the space",
  "shots": [
   "hover-shift-before.png",
   "hover-shift-after.png"
  ],
  "html": "<main class=\"page\"><div class=\"card\"></div><div class=\"below\"></div></main>",
  "css": ".page{display:grid;grid-template-columns:minmax(0,1fr);row-gap:8px}.card{height:100px;background:#9cf}.card:hover{height:150px}.below{height:60px;background:#fc9}"
 },
 {
  "id": "animation-shift",
  "title": "A margin animation that moves the page every frame",
  "code": "E_LAYOUT_ANIMATION_SHIFT",
  "width": 320,
  "height": 480,
  "message": "Animation drop at 100% on .banner sets a 60px start margin, which moves it (blockStart): a layout shift while it runs. Animate transform (translate) instead of margin",
  "shots": [
   "animation-shift-before.png",
   "animation-shift-after.png"
  ],
  "html": "<main class=\"page\"><div class=\"banner\"></div><div class=\"below\"></div></main>",
  "css": "@keyframes drop{from{margin-top:0}to{margin-top:60px}}.page{display:grid;grid-template-columns:minmax(0,1fr)}.banner{height:60px;background:#f99;animation:drop 1s infinite}.below{height:60px;background:#9cf}"
 },
 {
  "id": "carousel-shift",
  "title": "Carousel slides of different heights",
  "code": "E_LAYOUT_CAROUSEL_SHIFT",
  "width": 320,
  "height": 480,
  "message": "Switching .c from .s1 to .s2 moves .below (blockStart by 80px at viewport 320px × 480px): slides of different sizes shift the page. Give the slide area a fixed height or aspect-ratio, or stack the slides in one grid cell",
  "shots": [
   "carousel-shift-before.png",
   "carousel-shift-after.png"
  ],
  "html": "<main class=\"page\"><section class=\"c\" aria-roledescription=\"carousel\" aria-label=\"News\"><div class=\"s1\" aria-roledescription=\"slide\"></div><div class=\"s2\" aria-roledescription=\"slide\" hidden></div></section><div class=\"below\"></div></main>",
  "css": ".page{display:grid;grid-template-columns:minmax(0,1fr)}.c{display:grid;grid-template-columns:minmax(0,1fr)}.s1{height:100px;background:#9cf}.s2{height:180px;background:#69c}.below{height:60px;background:#fc9}"
 },
 {
  "id": "font-swap",
  "title": "Web-font text whose height follows the font",
  "code": "W_LAYOUT_FONT_SWAP",
  "width": 332,
  "height": 480,
  "message": ".t is set in the web font Roboto (font-display: swap) and takes its height from its text: when the font file arrives the text is laid out again. Use font-display: optional, preload the font, match the fallback metrics (size-adjust, ascent-override, descent-override), or reserve the box's height",
  "shots": [
   "font-swap-before.png",
   "font-swap-after.png"
  ],
  "html": "<main class=\"page\"><h1 class=\"t\">A heading set in a web font that wraps onto three lines</h1><div class=\"below\"></div></main>",
  "css": "@font-face{font-family:Roboto;src:url(/roboto.ttf);font-display:swap}.page{display:grid;grid-template-columns:300px}.t{font-family:Roboto,serif;font-size:32px;line-height:40px;font-weight:400}.below{height:40px;background:#fc9}"
 },
 {
  "id": "lazy-in-viewport",
  "title": "loading=\"lazy\" on an image above the fold",
  "code": "W_LAYOUT_LAZY_IN_VIEWPORT",
  "width": 320,
  "height": 480,
  "message": ".hero has loading=\"lazy\" but is in the initial viewport (top 16px at viewport 672px × 690px): it loads later than an eager image; drop loading=\"lazy\" for images above the fold (and consider fetchpriority=\"high\" for the largest one)",
  "shots": [
   "lazy-in-viewport-violation.png"
  ],
  "html": "<main class=\"page\"><img class=\"hero\" src=\"/wide.png\" width=\"800\" height=\"400\" loading=\"lazy\" alt=\"\"></main>",
  "css": ".page{display:grid;grid-template-columns:minmax(0,1fr)}.hero{display:block;width:100%;height:auto}"
 },
 {
  "id": "sizes-small",
  "title": "A sizes attribute smaller than the rendered width",
  "code": "W_LAYOUT_SIZES_SMALL",
  "width": 320,
  "height": 480,
  "message": ".hero is laid out 640px wide at viewport 672px but its sizes attribute says 168px: the browser picks a srcset file for the smaller width, so the image is upscaled (blurry). Make sizes match the layout width",
  "shots": [
   "sizes-small-violation.png"
  ],
  "html": "<main class=\"page\"><img class=\"hero\" src=\"/w400.png\" srcset=\"/w40.png 40w, /w80.png 80w, /w120.png 120w, /w160.png 160w, /w200.png 200w, /w240.png 240w, /w280.png 280w, /w320.png 320w, /w360.png 360w, /w400.png 400w, /w440.png 440w, /w480.png 480w, /w520.png 520w, /w560.png 560w, /w600.png 600w, /w640.png 640w, /w680.png 680w, /w720.png 720w, /w760.png 760w, /w800.png 800w, /w840.png 840w, /w880.png 880w, /w920.png 920w, /w960.png 960w, /w1000.png 1000w, /w1040.png 1040w, /w1080.png 1080w, /w1120.png 1120w, /w1160.png 1160w, /w1200.png 1200w\" sizes=\"25vw\" width=\"800\" height=\"400\" alt=\"\"></main>",
  "css": ".page{display:grid;grid-template-columns:minmax(0,1fr)}.hero{display:block;width:100%;height:auto}"
 },
 {
  "id": "line-clamp",
  "title": "A two-line clamp that cuts the title",
  "code": "W_LAYOUT_LINE_CLAMPED",
  "width": 320,
  "height": 480,
  "message": ".t is clamped to 2 lines and its text needs 3 at viewport 672px: the rest of the text is cut off (keep the full text available elsewhere, such as the page the card links to)",
  "shots": [
   "line-clamp-violation.png"
  ],
  "html": "<main class=\"page\"><p class=\"t\">A card title that is much longer than the two lines the design allows</p></main>",
  "css": ".page{display:grid;grid-template-columns:220px}.t{font-size:16px;line-height:24px;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;background:#eef}"
 },
 {
  "id": "sticky-inert",
  "title": "A sticky header wrapped in a box of its own height",
  "code": "W_LAYOUT_STICKY_INERT",
  "width": 320,
  "height": 480,
  "message": ".h is position: sticky, but its parent .wrap ends at its bottom: it scrolls away like a static box. Make it a child of the scrolling content (or give the parent the height it should stick across)",
  "shots": [
   "sticky-inert-before.png",
   "sticky-inert-after.png"
  ],
  "html": "<main class=\"page\"><div class=\"wrap\"><header class=\"h\"></header></div><div class=\"content\"></div></main>",
  "css": "body{padding:0}.page{display:grid;grid-template-columns:minmax(0,1fr)}.wrap{display:grid;grid-template-columns:minmax(0,1fr)}.h{position:sticky;top:0;height:56px;background:#246}.content{height:1600px;background:repeating-linear-gradient(#fff 0 40px,#eee 40px 80px)}"
 },
 {
  "id": "sticky-scroller",
  "title": "A sticky header inside overflow: hidden",
  "code": "W_LAYOUT_STICKY_SCROLLER",
  "width": 320,
  "height": 480,
  "message": ".h is position: sticky inside .page, which has overflow: hidden: it sticks to that box, which does not scroll, so it never sticks to the page. Use overflow: clip on the ancestor, or move the sticky box out of it",
  "shots": [
   "sticky-scroller-before.png",
   "sticky-scroller-after.png"
  ],
  "html": "<main class=\"page\"><header class=\"h\"></header><div class=\"content\"></div></main>",
  "css": "body{padding:0}.page{display:grid;grid-template-columns:minmax(0,1fr);overflow:hidden}.h{position:sticky;top:0;height:56px;background:#246}.content{height:1600px;background:repeating-linear-gradient(#fff 0 40px,#eee 40px 80px)}"
 },
