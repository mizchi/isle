client component Child(value: number) {
  state local = 0;
  event add(e: EventSnapshot<MouseEvent>) { local += 1; }
  <button type="button" on:click={add}>{value} / {local}</button>
}
client component Parent() {
  state n = 0;
  event add(e: EventSnapshot<MouseEvent>) { n += 1; }
  <main>
    <button type="button" on:click={add}>Parent +1</button>
    <Child value={n} />
  </main>
}
