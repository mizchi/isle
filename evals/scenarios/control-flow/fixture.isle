
schema Item { id: string; value: number; }
component Row(item: Item, index: number, children: RenderFragment) { <li data-key={item.id}>Row <span>{index}</span>, value <output>{item.value}</output>{children}</li> }
client component Controls(initial: Item[]) {
  state items: Item[] = initial;
  state visible = true;
  state mode = "rows";
  state offset = 0;
  <section>
    <button type="button" data-test="hide">on click hide { visible = false; }Hide</button>
    <button type="button" data-test="show">on click show { visible = true; }Show</button>
    <button type="button" data-test="reverse">on click reverse { items = [items[1], items[0]]; }Reverse</button>
    <button type="button" data-test="empty">on click empty { items = []; }Empty</button>
    <button type="button" data-test="duplicate">on click duplicate { items = [items[0], items[0]]; }Duplicate</button>
    <button type="button" data-test="add">on click add { offset += 1; }Add</button>
    <button type="button" data-test="summary">on click summary { mode = "summary"; }Summary</button>
    <button type="button" data-test="restore">on click restore { items = initial; }Restore</button>
    <Show when={visible} fallback={<p data-test="hidden">Hidden</p>}>
      <div data-test="visible">Visible <output>{offset}</output></div>
    </Show>
    <Switch fallback={<p data-test="mode">Other</p>}>
      <Match when={mode === "rows"}><p data-test="mode">Rows</p></Match>
      <Match when={mode === "summary"}><p data-test="mode">Summary</p></Match>
    </Switch>
    <ul><For each={items} fallback={<li data-test="empty-message">Empty</li>}>
      {(item, i) => <Fragment key={item.id}>
        <Row item={item} index={i}><button type="button" data-item={item.id}>on click select { offset = item.value; }Select</button></Row>
        <li><small>Total <output data-price={item.id}>{item.value + offset}</output></small></li>
      </Fragment>}
    </For></ul>
    <ErrorBoundary fallback={(error) => <p data-test="error">{error}</p>}>
      <p data-test="first">{items[0].value}</p>
    </ErrorBoundary>
  </section>
}
client component Nested(groups: string[], numbers: number[]) {
  state selected = "none";
  state value = 0;
  state shown = true;
  <section>
    <button type="button" data-test="nested-hide">on click hide { shown = false; }Hide rows</button>
    <button type="button" data-test="nested-show">on click show { shown = true; }Show rows</button>
    <output data-test="nested-result">{selected}{value}</output>
    <Show when={shown}>
      <For each={groups}>{(group) => <div key={group} data-group={group}>
        <For each={numbers}>{(n) => <button key={n} type="button" data-group={group} data-number={n}>on click choose { selected = group; value = n; }{group}{n}</button>}</For>
      </div>}</For>
    </Show>
    <ErrorBoundary fallback={(outer) => <p data-test="outer-error">{outer}</p>}>
      <ErrorBoundary fallback={(inner) => <p>{numbers[98]}</p>}><p>{numbers[99]}</p></ErrorBoundary>
    </ErrorBoundary>
  </section>
}
