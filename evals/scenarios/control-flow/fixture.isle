
schema Item { id: string; value: number; }
component Row(item: Item, index: number) { <li data-key={item.id}>Row <span>{index}</span>, value <output>{item.value}</output></li> }
client component Controls(initial: Item[]) {
  state items: Item[] = initial;
  state visible = true;
  state mode = "rows";
  state offset = 0;
  <section>
    <button type="button" data-test="hide">on click hide { visible = false; }Hide</button>
    <button type="button" data-test="show">on click show { visible = true; }Show</button>
    <button type="button" data-test="reverse">on click reverse { items = [items[1], items[0]]; }Reverse</button>
    <button type="button" data-test="empty">on click empty { items = []; }Empty</button>
    <button type="button" data-test="duplicate">on click duplicate { items = [items[0], items[0]]; }Duplicate</button>
    <button type="button" data-test="add">on click add { offset += 1; }Add</button>
    <button type="button" data-test="summary">on click summary { mode = "summary"; }Summary</button>
    <button type="button" data-test="restore">on click restore { items = initial; }Restore</button>
    @if (visible) {
      <div data-test="visible">Visible <output>{offset}</output></div>
    } @else { <p data-test="hidden">Hidden</p> }
    @switch (mode) {
      @case "rows": { <p data-test="mode">Rows</p> }
      @case "summary": { <p data-test="mode">Summary</p> }
      @default: { <p data-test="mode">Other</p> }
    }
    <ul>@for (const item of items; index i; key item.id) {
      <Row item={item} index={i} />
      <li><small>Total <output data-price={item.id}>{item.value + offset}</output></small></li>
      <li><button type="button" data-item={item.id}>on click select { offset = item.value; }Select</button></li>
    } @empty { <li data-test="empty-message">Empty</li> }</ul>
    @try { <p data-test="first">{items[0].value}</p> }
    @catch (error) { <p data-test="error">{error}</p> }
  </section>
}
client component Nested(groups: string[], numbers: number[]) {
  state selected = "none";
  state value = 0;
  state shown = true;
  <section>
    <button type="button" data-test="nested-hide">on click hide { shown = false; }Hide rows</button>
    <button type="button" data-test="nested-show">on click show { shown = true; }Show rows</button>
    <output data-test="nested-result">{selected}{value}</output>
    @if (shown) {
      @for (const group of groups; key group) {
        <div data-group={group}>
          @for (const n of numbers; key n) {
            <button type="button" data-group={group} data-number={n}>on click choose { selected = group; value = n; }{group}{n}</button>
          }
        </div>
      }
    }
    @try {
      @try {<p>{numbers[99]}</p>} @catch (inner) {<p>{numbers[98]}</p>}
    } @catch (outer) {<p data-test="outer-error">{outer}</p>}
  </section>
}
