{
  "name": "@isle/prototype",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "An ahead-of-time compiled, resumable UI library with statically checked CSS layout contracts.",
  "repository": { "type": "git", "url": "git+https://github.com/mizchi/isle.git" },
  "exports": {
    "./vite": { "types": "./lib/vite.d.mts", "import": "./lib/vite.mjs" },
    "./compiler": { "types": "./lib/compiler.d.mts", "import": "./lib/compiler.mjs" },
    "./compiler/browser": { "types": "./lib/compiler-browser.d.mts", "import": "./lib/compiler-browser.mjs" },
    "./preview": { "types": "./lib/preview.d.mts", "import": "./lib/preview.mjs" },
    "./server": { "types": "./lib/server.d.mts", "import": "./lib/server.mjs" },
    "./layout": { "types": "./lib/layout.d.mts", "import": "./lib/layout.mjs" },
    "./layout/z3": { "types": "./lib/layout-z3.d.mts", "import": "./lib/layout-z3.mjs" },
    "./layout/z3/node": { "types": "./lib/layout-z3-node.d.mts", "import": "./lib/layout-z3-node.mjs" },
    "./layout/contracts": { "types": "./lib/layout-contract.d.mts", "import": "./lib/layout-contract.mjs" },
    "./layout/contracts/node": { "types": "./lib/layout-contract-node.d.mts", "import": "./lib/layout-contract-node.mjs" },
    "./layout/transitions": { "types": "./lib/layout-transition.d.mts", "import": "./lib/layout-transition.mjs" },
    "./layout/transitions/node": { "types": "./lib/layout-transition-node.d.mts", "import": "./lib/layout-transition-node.mjs" },
    "./layout/noshift": { "types": "./lib/layout-noshift.d.mts", "import": "./lib/layout-noshift.mjs" },
    "./layout/noshift/node": { "types": "./lib/layout-noshift-node.d.mts", "import": "./lib/layout-noshift-node.mjs" },
    "./widget": { "types": "./lib/widget.d.mts", "import": "./lib/widget.mjs" },
    "./widget/browser": { "types": "./runtime/widget.d.mts", "import": "./runtime/widget.mjs" },
    "./resources": { "types": "./runtime/resource-owner.d.mts", "import": "./runtime/resource-owner.mjs" }
  },
  "bin": { "isle": "./tools/isle.mjs" },
  "files": ["packages/css-verifier/src/", "lib/", "runtime/", "_build/js/release/build/compiler/compiler.js", "_build/browser/preview-runtime.txt", "tools/isle.mjs", "README.md", "README.ja.md"],
  "peerDependencies": { "vite": "^8.3.5" },
  "dependencies": { "postcss": "8.5.32", "parse5": "8.0.1", "css-tree": "3.2.1", "z3-solver": "5.3.3" },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepack": "pnpm build:compiler",
    "build:compiler": "moon build compiler --target js --release && node tools/build-preview-runtime.mjs",
    "test": "node --test tests/*.test.mjs",
    "eval": "node tools/eval.mjs",
    "dev": "vite --config examples/counter/vite.config.mjs",
    "build": "pnpm build:compiler && vite build --config examples/counter/vite.config.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@mizchi/vlmkit": "0.24.0",
    "@playwright/test": "^1.64.1",
    "marked": "18.1.3",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "4.157.0"
  }
}
