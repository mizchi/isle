component Variables() {
  <main class="row" aria-label="CSS variable grid">
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      .row {
        --cell: 40px;
        --columns: 4;
        display: grid;
        grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
        grid-auto-rows: 40px;
      }
      .cell { min-width: var(--cell); height: 40px; border: 1px solid #357166; background: #c6e9db; }
      @media (width < 160px) { .row { --columns: 2; } }
    </style>
    <div class="cell" /><div class="cell" /><div class="cell" /><div class="cell" />
  </main>
}
