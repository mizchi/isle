export client component DynamicBoard() {
  state items = [0];
  state compact = false;
  <main class="board">
    <h1 class="title">Checked dynamic Grid</h1>
    <nav class="controls" aria-label="Cards">
      <button class="action" type="button">on click { items = items.length < 4 ? items.concat([items.length]) : items; }Add</button>
      <button class="action" type="button">on click { items = []; }Clear</button>
      <button class="action" type="button" aria-pressed={compact}>on click { compact = !compact; }Style</button>
    </nav>
    <section class="scroller" aria-label="Scrollable cards" tabindex="0">
      <For each={items} fallback={<p class="empty">No cards</p>}>
        {(item) => <div key={item} class={compact ? "tile compact" : "tile"}>Card {item}</div>}
      </For>
    </section>
    <Show when={items.length === 0} fallback={<p class="note">Scroll to see every card.</p>}>
      <p class="note">Add up to four cards.</p>
    </Show>
  </main>
}
