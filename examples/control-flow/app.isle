schema Item { id: string; title: string; }
component Row(item: Item) { <li data-key={item.id}>{item.title}</li> }

client component List(initial: Item[]) {
  state items: Item[] = initial;
  state visible = true;
  state mode = "list";
  event hide(event: EventSnapshot<MouseEvent>) { visible = false; }
  event show(event: EventSnapshot<MouseEvent>) { visible = true; }
  event reverse(event: EventSnapshot<MouseEvent>) { items = [items[1], items[0]]; }
  event empty(event: EventSnapshot<MouseEvent>) { items = []; }
  event restore(event: EventSnapshot<MouseEvent>) { items = initial; }
  event summary(event: EventSnapshot<MouseEvent>) { mode = "summary"; }
  <section>
    <button type="button" on:click={hide}>Hide</button>
    <button type="button" on:click={show}>Show</button>
    <button type="button" on:click={reverse}>Reverse rows</button>
    <button type="button" on:click={empty}>Empty list</button>
    <button type="button" on:click={restore}>Restore rows</button>
    <button type="button" on:click={summary}>Summary</button>
    <Show when={visible} fallback={<p data-visibility="">Hidden</p>}>
      <p data-visibility="">Visible</p>
    </Show>
    <Switch fallback={<p data-mode="">Other view</p>}>
      <Match when={mode === "list"}><p data-mode="">List view</p></Match>
      <Match when={mode === "summary"}><p data-mode="">Summary view</p></Match>
    </Switch>
    <ul><For each={items} fallback={<li>No rows</li>}>
      {(item) => <Row key={item.id} item={item} />}
    </For></ul>
    <ErrorBoundary fallback={(error) => <p data-error="">No first row: {error}</p>}>
      <p data-first="">First: {items[0].title}</p>
    </ErrorBoundary>
  </section>
}
