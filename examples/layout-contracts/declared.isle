component Four() {
  layout SafeGrid {
    requires {
      inline-size: 160px..640px;
      block-size: 40px..640px;
    }
    ensures {
      overflow-inline: fit;
      overflow-block: fit;
    }
  }
  <main class="row" aria-label="Four checked cells">
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      .row {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        grid-auto-rows: 40px;
      }
      .cell { min-inline-size: 40px; block-size: 40px; background: #c6e9db; border: 1px solid #357166; }
    </style>
    <div class="cell" /><div class="cell" /><div class="cell" /><div class="cell" />
  </main>
}
