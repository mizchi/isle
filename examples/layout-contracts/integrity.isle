component Toolbar() {
  <main class="bar" aria-label="Toolbar">
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      .bar { display: flex; align-items: center; column-gap: 8px; block-size: 48px; padding: 0 12px; background: #e7f2ec; }
      .title { flex: 1 1 0; min-width: 0; block-size: 24px; overflow: hidden; white-space: nowrap; }
      .icon { appearance: none; display: block; flex: none; width: 24px; height: 24px; min-width: 0; min-height: 0; border: 1px solid #357166; background: #c6e9db; }
    </style>
    <p class="title">Inbox</p>
    <button class="icon" type="button" aria-label="Search"></button>
    <button class="icon" type="button" aria-label="Settings"></button>
  </main>
}
