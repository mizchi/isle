{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "isle-widget",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "send_metrics": false,
  "assets": {
    "directory": "../../dist/worker-widget/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/__isle/*"]
  }
}
